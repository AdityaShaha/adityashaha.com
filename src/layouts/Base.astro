---
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/inter/opsz-italic.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE, NAV } from '../site';

// A full-width header painting ("wall") shown under the navigation.
interface Wall {
  src: ImageMetadata;
  alt: string;
  credit: string;
  pos?: string;
}

interface Props {
  title?: string;
  description?: string;
  wall?: Wall;
}

const { title, description = SITE.description, wall } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="top">
      <a href="/" class="wordmark">{SITE.name}</a>
      <nav>
        {NAV.map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.name}</a>)}
      </nav>
    </header>

    {
      wall && (
        <figure class="wall">
          <Image
            src={wall.src}
            alt={wall.alt}
            widths={[640, 1024, 1600, 2000]}
            sizes="100vw"
            quality={64}
            loading="eager"
            fetchpriority="high"
            style={`object-position:${wall.pos ?? '50% 50%'}`}
          />
          <figcaption set:html={wall.credit} />
        </figure>
      )
    }

    <main>
      <slot />
    </main>

    <footer>
      <span>© {new Date().getFullYear()} {SITE.name} · Köln</span>
      <div>
        <a href={SITE.linkedin} rel="me">LinkedIn</a>
        <a href={SITE.github} rel="me">GitHub</a>
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .top {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px 24px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-size: 0.85rem;
  }
  .wordmark {
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 1.05rem;
    white-space: nowrap;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 24px;
    color: var(--muted);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: #c9a24a;
    text-underline-offset: 6px;
  }
  .wall {
    position: relative;
    margin: 0;
    height: clamp(220px, 42vh, 460px);
    overflow: hidden;
    background: #d9d2c4;
  }
  .wall img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .wall figcaption {
    position: absolute;
    right: 16px;
    bottom: 10px;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }
  main {
    min-height: 40vh;
  }
  footer {
    max-width: 1080px;
    margin: 120px auto 0;
    padding: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.75rem;
    color: var(--faint);
  }
  footer div {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
  footer a:hover {
    color: var(--ink);
  }
  @media (max-width: 760px) {
    .top {
      flex-direction: column;
      align-items: flex-start;
    }
    nav {
      justify-content: flex-start;
      gap: 6px 18px;
    }
    .wall {
      height: 240px;
    }
  }
</style>
