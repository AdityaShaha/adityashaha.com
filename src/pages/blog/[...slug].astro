---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, formatDate } from '../../posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <p class="eyebrow"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
    <h1>{post.data.title}</h1>
    <div class="prose"><Content /></div>
  </article>
  <p class="back"><a href="/blog/">← All writing</a></p>
</Base>

<style>
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    margin: 0.75rem 0 2rem;
  }
  .back {
    margin-top: 3rem;
  }
</style>
