---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, formatDate } from '../../posts';
import gisze from '../../assets/art/holbein-gisze-wide.jpg';

const posts = await getPublishedPosts();
---

<Base
  title="Blog"
  description="Aditya Shaha's blog: mostly machine learning, sometimes whatever I am learning, occasionally life."
  wall={{
    src: gisze,
    alt: "Holbein's The Merchant Georg Gisze: a merchant at his desk, surrounded by letters and documents.",
    credit: 'Hans Holbein the Younger, <em>The Merchant Georg Gisze</em>, 1532',
    pos: '50% 22%',
  }}
>
  <header class="page-head">
    <h1 class="display">Blog.</h1>
    <p>Mostly machine learning, sometimes whatever I am learning, occasionally life.</p>
  </header>

  <section class="list">
    {
      posts.length ? (
        posts.map((post) => (
          <a class="post" href={`/blog/${post.id}/`}>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <h2 class="display">{post.data.title}</h2>
            <p>{post.data.description}</p>
            {post.data.tags.length > 0 && <span class="tags">{post.data.tags.map((t) => `#${t}`).join('  ')}</span>}
          </a>
        ))
      ) : (
        <p class="empty">No posts yet. The first one is on its way.</p>
      )
    }
  </section>
</Base>

<style>
  .page-head,
  .list {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .page-head {
    padding-top: 72px;
    padding-bottom: 48px;
  }
  h1 {
    font-size: clamp(2.8rem, 7vw, 5rem);
    margin: 0;
  }
  .page-head p {
    font-size: 1.2rem;
    color: var(--muted);
    margin: 14px 0 0;
    max-width: 560px;
    text-wrap: balance;
  }
  .list {
    border-top: 1px solid var(--line);
  }
  .post {
    display: block;
    max-width: 700px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  time,
  .tags {
    font-family: var(--mono);
    font-size: 0.75rem;
  }
  time {
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .post h2 {
    font-size: 1.45rem;
    line-height: 1.2;
    margin: 8px 0 6px;
    transition: color 0.15s;
  }
  .post:hover h2 {
    color: var(--gold);
  }
  .post p {
    margin: 0 0 8px;
    color: var(--muted);
    line-height: 1.5;
  }
  .tags {
    color: #a1a1a6;
    white-space: pre;
  }
  .empty {
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.05rem;
    color: var(--faint);
    margin: 0;
  }
</style>
