---
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, formatDate } from '../../posts';

const posts = await getPublishedPosts();
---

<Base title="Writing" description="Essays on demand forecasting, recommendations and applied ML for e-commerce and supply chain.">
  <p class="eyebrow">Writing</p>
  <h1>Notes from production ML</h1>
  {
    posts.length ? (
      <ul class="list">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">The first posts are being written. Subscribe via <a href="/rss.xml">RSS</a> to get them.</p>
    )
  }
</Base>

<style>
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.5rem);
    margin: 0.75rem 0 2rem;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .list li {
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
  }
  .list a {
    display: block;
    font: 600 1.2rem/1.35 var(--serif);
    color: var(--ink);
    text-decoration: none;
    margin: 0.2rem 0 0.35rem;
  }
  .list a:hover {
    color: var(--accent);
  }
  time,
  .list p,
  .empty {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
