---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import harvesters from '../assets/art/bruegel-harvesters.jpg';
---

<Base
  wall={{
    src: harvesters,
    alt: "Bruegel's The Harvesters: peasants cutting and carrying golden wheat across a summer landscape.",
    credit: 'Pieter Bruegel the Elder, <em>The Harvesters</em>, 1565',
    pos: '50% 62%',
  }}
>
  <section class="hero">
    <h1 class="display">Hi, I'm Aditya.</h1>
    <p class="sub">
      I'm a data scientist in Köln. This is where I'll write about what I'm building, what I'm learning, and the old
      paintings I keep coming back to.
    </p>
    <p class="links">
      <a href={SITE.linkedin}>LinkedIn</a><a href={SITE.github}>GitHub</a><a href={`mailto:${SITE.email}`}>Email</a>
    </p>
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 72px 24px 0;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    line-height: 1.04;
    margin: 0;
  }
  .sub {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.5;
    color: var(--muted);
    max-width: 620px;
    margin: 22px auto 0;
    text-wrap: balance;
  }
  .links {
    display: flex;
    justify-content: center;
    gap: 28px;
    margin: 32px 0 0;
    font-size: 1rem;
  }
  .links a {
    color: var(--gold);
  }
  @media (max-width: 760px) {
    .hero {
      padding-top: 48px;
    }
  }
</style>
